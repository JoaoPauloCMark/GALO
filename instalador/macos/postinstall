#!/bin/sh
# Roda depois que o instalador do macOS copia os arquivos (como administrador).
# Pré-compila o pacote galo e instala a extensão nos editores de quem está usando o Mac.
/usr/local/galo/runtime/bin/python3 -I -m compileall -q /usr/local/galo/runtime/lib/python3.13/site-packages/galo >/dev/null 2>&1 || true
usuario="$(stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$usuario" ] && [ "$usuario" != "root" ]; then
    sudo -u "$usuario" -H /usr/local/bin/galo extensao >/dev/null 2>&1 || true
fi
exit 0
