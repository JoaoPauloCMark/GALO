programa "Tratamento de erros"

função dividir_seguro(a como número, b como número) retorna número
    se b == 0 então
        lance {"mensagem": "Divisor zero não é permitido", "divisor": b}
    fim
    retorne a / b
fim

para cada divisor em [2, 0, 4] faça
    tente
        mostre "10 / {divisor} =", dividir_seguro(10, divisor)
    capture erro
        mostre "Falhou:", erro.mensagem
    fim
fim

# Erros da própria linguagem também podem ser capturados
defina valores como ["42", "3,5", "abc"]
para cada v em valores faça
    tente
        mostre "'{v}' vira", número(v)
    capture erro
        mostre "Código {erro.código}: {erro.mensagem}"
    fim
fim

tente
    defina lista como [1, 2, 3]
    mostre lista[10]
capture problema
    mostre "Erro na linha {problema.linha}: {problema.mensagem}"
fim
